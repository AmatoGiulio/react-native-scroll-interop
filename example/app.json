{
  "expo": {
    "name": "Material Toolbar Example",
    "slug": "expo-material-toolbar-example",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "materialtoolbarexample",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "expo.modules.materialtoolbar.example",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-material-toolbar",
        {
          "android": {
            "rn086AndroidXScroll": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
