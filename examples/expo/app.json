{
  "expo": {
    "name": "Scroll Interop Example",
    "slug": "react-native-scroll-interop-example",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "scrollinteropexample",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true,
      "hidden": false
    },
    "android": {
      "package": "expo.modules.materialtoolbar.example",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "./plugins/withDemoToolbarIcons",
      [
        "../../app.plugin.js",
        {
          "android": {
            "reactNativeScrollCompat": true,
            "reactNativeScreensInterop": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
