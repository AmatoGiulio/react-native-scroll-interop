{
  "name": "react-native-scroll-interop-expo-example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "postinstall": "node ./scripts/patch-expo-ui-nested-scroll-interop.mjs",
    "android": "node ./scripts/patch-expo-ui-nested-scroll-interop.mjs && expo run:android",
    "prebuild": "node ./scripts/patch-expo-ui-nested-scroll-interop.mjs && expo prebuild -p android --clean"
  },
  "dependencies": {
    "@expo/ui": "57.0.12",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-scroll-interop": "file:../..",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
