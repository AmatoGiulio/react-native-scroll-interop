{
  "name": "react-native-scroll-interop",
  "version": "0.1.0-alpha.1",
  "description": "Android-native scroll interoperability for React Native, exposing the source's real nested-scroll transaction to native UI consumers.",
  "license": "MIT",
  "author": "Giulio Amato",
  "main": "index.ts",
  "types": "index.ts",
  "files": [
    "android/build.gradle",
    "android/src/main",
    "android-shared/README.md",
    "android-shared/src/main",
    "plugin",
    "src",
    "index.ts",
    "app.plugin.js",
    "expo-module.config.json",
    "ARCHITECTURE.md",
    "PRODUCT.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "expo",
    "android",
    "nested-scroll",
    "scroll-interop",
    "material3",
    "top-app-bar",
    "floating-toolbar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmatoGiulio/react-native-scroll-interop.git"
  },
  "homepage": "https://github.com/AmatoGiulio/react-native-scroll-interop#readme",
  "bugs": {
    "url": "https://github.com/AmatoGiulio/react-native-scroll-interop/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "analyze:scroll-log": "node scripts/analyze-scroll-log.mjs",
    "analyze:rn087-source": "node scripts/analyze-rn087-source-log.mjs",
    "check:scroll-invariants": "node scripts/check-scroll-invariants.mjs && node scripts/check-material3-adapter-invariants.mjs",
    "check:navigation-integration": "node scripts/check-navigation-integration.mjs",
    "check:rn086-androidx-plugin": "node scripts/check-rn086-androidx-plugin.mjs",
    "check:rnscreens-interop-plugin": "node scripts/check-rnscreens-interop-plugin.mjs",
    "check:package-surface": "node scripts/check-package-surface.mjs",
    "check": "npm run check:scroll-invariants && npm run check:navigation-integration && npm run check:rn086-androidx-plugin && npm run check:rnscreens-interop-plugin && npm run check:package-surface",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "expo": ">=57.0.0 <58.0.0",
    "react": ">=19.2.0 <20.0.0",
    "react-native": ">=0.86.0 <0.87.0",
    "react-native-safe-area-context": ">=5.0.0 <6.0.0"
  }
}
